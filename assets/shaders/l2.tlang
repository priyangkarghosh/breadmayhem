[extend!('subgroup')]
[program('blit', vert='default_vert', frag='blit')]

[shader('vert')]
[resourceblock(
    in vec2 vert;
    in vec2 texCoord;
    out vec2 v_uv;
)]
void default_vert() {
    v_uv = vec2(texCoord.x, clamp(1.0 - texCoord.y, 0.0, 1.0));
    gl_Position = vec4(vert, 0.0, 1.0);
}

[shader('frag')]
[resourceblock(
    uniform int _cascadeIndex;
    uniform sampler2DArray _cascadeTex;

    in vec2 v_uv;
    out vec4 fragColour;
)]
void blit() {
    vec3 uv = vec3(v_uv.x, 1.0 - v_uv.y, _cascadeIndex);
    fragColour = texture(_cascadeTex, uv);
}

const float TAU = 6.28318530718;
const float EPSILON = 1e-3;

#define SRGB(c) pow(c.rgb, vec3(1.0 / 2.2))
#define LINEAR(c) pow(c.rgb, vec3(2.2))

[link('build_cascade')]
vec4 raymarch(vec2 origin, vec2 delta, float range) {
    const vec2 texel = 1.0 / _renderResolution;
    vec2 ray = origin * texel;
    vec2 rayStep = delta * texel;
    for (float i = 0.0; i < range; i++) {
        ray += rayStep;
        if (floor(ray) != vec2(0.0)) break;

        vec4 albedo = texture(_albedoTex, ray);
        if (albedo.a > 0.0) {
            // hit something, check for emission
            vec3 emission = LINEAR(texture(_emissiveTex, ray).rgb);
            if (length(emission) > 0.0) return vec4(emission, 0.0);
            else return vec4(LINEAR(albedo.rgb), 0.0);
        }
    }

    return vec4(0.0, 0.0, 0.0, 1.0);
}

// workgroups in format:
// wg.x = cascade_size.x, wg.y = cascade_size.y
[shader('compute'), numthreads(16, 16, 1)]
[resourceblock(
    layout(rgba16f, binding=0) uniform writeonly image2DArray _cascadeTex;

    uniform sampler2D _albedoTex;
    uniform sampler2D _emissiveTex;

    uniform ivec2 _renderResolution;
    uniform ivec2 _cascadeResolution;

    uniform int _cascadeIndex;
    uniform int _cascadeCount;
    uniform float _cascadeScale;
    uniform float _cascadeInterval;
)]
void build_cascade() {
    // calculate texcoord
    ivec3 texCoord = ivec3(gl_GlobalInvocationID.xy, _cascadeIndex);

    //    
    float angular = 4 * pow(4, _cascadeIndex);
    float sqrtAngular = sqrt(angular);
    ivec2 extent = ivec2(floor(_cascadeResolution / sqrtAngular));
    ivec4 probe = ivec4(mod(texCoord.xy, extent), floor(texCoord.xy / extent));
    vec2 linear = vec2(_cascadeScale * sqrtAngular);

    //
    float pow4 = floor(1 << (2 * _cascadeIndex));
    float offset = _cascadeInterval * ((1.0 - pow4) / -3.0);
    float range = _cascadeInterval * pow4;
    
    //
    vec2 origin = (probe.xy + 0.5) * linear;
    int index = int(probe.z + (probe.w * sqrtAngular));
    float theta = TAU * ((index + 0.5) / angular);
    vec2 delta = vec2(cos(theta), -sin(theta));
    vec4 rad = raymarch(origin + delta * offset, delta, range);
    imageStore(_cascadeTex, texCoord, rad);
}

[link('merge_cascades')]
vec4 merge(vec4 radiance, float base, vec2 extent, vec2 probe) {
    if (radiance.a == 0.0 || _cascadeIndex >= _cascadeCount - 1)
        return vec4(radiance.rgb, 1 - radiance.a);
    
    float angularN1 = pow(2, _cascadeIndex + 1);
    vec2 extentN1 = floor(_cascadeResolution / angularN1);
    vec2 interpN1 = vec2(mod(base, angularN1), floor(base / angularN1)) * extentN1;
    interpN1 += clamp((probe * 0.5) + 0.25, vec2(0.5), extentN1 - 0.5);
    
    // Bilinear interpolation
    vec2 texelCoord = interpN1 - 0.5;
    ivec2 baseCoord = ivec2(floor(texelCoord));
    vec2 frac = texelCoord - vec2(baseCoord);
    
    // Sample 4 neighboring texels
    vec4 s00 = imageLoad(_cascadeTex, ivec3(baseCoord + ivec2(0, 0), _cascadeIndex + 1));
    vec4 s10 = imageLoad(_cascadeTex, ivec3(baseCoord + ivec2(1, 0), _cascadeIndex + 1));
    vec4 s01 = imageLoad(_cascadeTex, ivec3(baseCoord + ivec2(0, 1), _cascadeIndex + 1));
    vec4 s11 = imageLoad(_cascadeTex, ivec3(baseCoord + ivec2(1, 1), _cascadeIndex + 1));
    
    // Bilinear blend
    vec4 s0 = mix(s00, s10, frac.x);
    vec4 s1 = mix(s01, s11, frac.x);
    vec4 mergeRadiance = mix(s0, s1, frac.y);
    
    return vec4(radiance.rgb + mergeRadiance.rgb * radiance.a, radiance.a * mergeRadiance.a);
}

[shader('compute'), numthreads(16, 16, 1)]
[resourceblock(
    layout(rgba16f, binding=0) uniform image2DArray _cascadeTex;
    uniform ivec2 _cascadeResolution;
    uniform int _cascadeIndex;
    uniform int _cascadeCount;
)]
void merge_cascades() {
    // calculate texcoord
    ivec3 texCoord = ivec3(gl_GlobalInvocationID.xy, _cascadeIndex);

    float angular = 4 * pow(4, _cascadeIndex);
    float sqrtAngular = sqrt(angular);
    ivec2 extent = ivec2(floor(_cascadeResolution / sqrtAngular));
    ivec4 probe = ivec4(mod(texCoord.xy, extent), floor(texCoord.xy / extent));
    
    //
    int index = int(probe.z + (probe.w * sqrtAngular));
    vec4 r = imageLoad(_cascadeTex, texCoord);
    r = merge(r, index, extent, probe.xy);
    if (_cascadeIndex == 0) r.rgb = SRGB(r.rgb);
    imageStore(_cascadeTex, texCoord, r);
}