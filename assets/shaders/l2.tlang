[extend!('subgroup')]
[program('blit', vert='default_vert', frag='blit')]

[shader('vert')]
[resourceblock(
    in vec2 vert;
    in vec2 texCoord;
    out vec2 v_uv;
)]
void default_vert() {
    v_uv = vec2(texCoord.x, clamp(1.0 - texCoord.y, 0.0, 1.0));
    gl_Position = vec4(vert, 0.0, 1.0);
}

[shader('frag')]
[resourceblock(
    uniform int _cascadeIndex;
    uniform sampler2DArray _cascadeTex;

    in vec2 v_uv;
    out vec4 fragColour;
)]
void blit() {
    vec3 uv = vec3(v_uv.x, 1.0 - v_uv.y, _cascadeIndex);
    fragColour = texture(_cascadeTex, uv);
}

const float TAU = 6.28318530718;
const float EPSILON = 1e-3;

#define SRGB(c) pow(c.rgb, vec3(1.0 / 2.2))
#define LINEAR(c) pow(c.rgb, vec3(2.2))

[link('build_cascade')]
vec4 raymarch(vec2 origin, vec2 delta, float range) {
    const vec2 texel = 1.0 / _renderResolution;
    vec2 ray = origin * texel;
    vec2 rayStep = delta * texel;
    for (float i = 0.0; i < range; i++) {
        ray += rayStep;
        if (floor(ray) != vec2(0.0)) break;

        vec4 albedo = texture(_albedoTex, ray);
        if (albedo.a > 0.0) {
            // hit something, check for emission
            vec3 emission = LINEAR(texture(_emissiveTex, ray).rgb);
            if (length(emission) > 0.0) return vec4(emission, 0.0);
            else return vec4(LINEAR(albedo.rgb), 0.0);
        }
    }

    return vec4(0.0, 0.0, 0.0, 1.0);
}

// workgroups in format:
// wg.x = cascade_size.x, wg.y = cascade_size.y
[shader('compute'), numthreads(16, 16, 1)]
[resourceblock(
    layout(rgba16f, binding=0) uniform writeonly image2DArray _cascadeTex;

    uniform sampler2D _albedoTex;
    uniform sampler2D _emissiveTex;

    uniform ivec2 _renderResolution;
    uniform ivec2 _cascadeResolution;

    uniform int _cascadeIndex;
    uniform int _cascadeCount;
    uniform float _cascadeScale;
    uniform float _cascadeInterval;
)]
void build_cascade() {
    // calculate texcoord
    ivec3 texCoord = ivec3(gl_GlobalInvocationID.xy, _cascadeIndex);

    //    
    float angular = 4 * pow(4, _cascadeIndex);
    float sqrtAngular = sqrt(angular);
    ivec2 extent = ivec2(floor(_cascadeResolution / sqrtAngular));
    ivec4 probe = ivec4(mod(texCoord.xy, extent), floor(texCoord.xy / extent));
    vec2 linear = vec2(_cascadeScale * sqrtAngular);

    //
    float pow4 = floor(1 << (2 * _cascadeIndex));
    float offset = _cascadeInterval * ((1.0 - pow4) / -3.0);
    float range = _cascadeInterval * pow4;
    
    //
    vec2 origin = (probe.xy + 0.5) * linear;
    int index = int(probe.z + (probe.w * sqrtAngular));
    float theta = TAU * ((index + 0.5) / angular);
    vec2 delta = vec2(cos(theta), -sin(theta));
    vec4 rad = raymarch(origin + delta * offset, delta, range);
    imageStore(_cascadeTex, texCoord, rad);
}

struct ProbeInfo {
    float angular;
    float sqrtAngular;
    ivec2 extent;
    ivec4 probe;
    float index;
};

[link('merge_cascades')]
ProbeInfo get_probe(ivec2 texCoord, int cascadeIndex) {
    float angular = 4 * pow(4, cascadeIndex);
    float sqrtAngular = sqrt(angular);
    ivec2 extent = ivec2(floor(_cascadeResolution / sqrtAngular));
    ivec4 probe = ivec4(mod(texCoord.xy, extent), floor(texCoord.xy / extent));
    float index = floor(probe.z + (probe.w * sqrtAngular));
    return ProbeInfo(angular, sqrtAngular, extent, probe, index);
}

[link('merge_cascades')]
vec4 cascadeFetch(ProbeInfo info, int cascadeIndex, vec2 texelIndex, float thetaIndex) {
	vec2 probeTexel = texelIndex * info.sqrtAngular;
	probeTexel += vec2(mod(thetaIndex, info.sqrtAngular), thetaIndex / info.sqrtAngular);

	vec2 cascadeTexelPosition = probeTexel / _cascadeResolution;
	if (cascadeTexelPosition.x < 0.0 || cascadeTexelPosition.y < 0.0 || cascadeTexelPosition.x >= 1.0 || cascadeTexelPosition.y >= 1.0)
		return vec4(0.0, 0.0, 0.0, 0.0);
	return imageLoad(_cascadeTex, ivec3(probeTexel, cascadeIndex));
}

[shader('compute'), numthreads(16, 16, 1)]
[resourceblock(
    layout(rgba16f, binding=0) uniform image2DArray _cascadeTex;
    uniform ivec2 _cascadeResolution;
    uniform int _cascadeIndex;
    uniform int _cascadeCount;
)]
void merge_cascades() {
    // calculate texcoord
    ivec3 texCoord = ivec3(gl_GlobalInvocationID.xy, _cascadeIndex);
    ProbeInfo probeInfo = get_probe(texCoord.xy, _cascadeIndex);
    ProbeInfo probeInfoN1 = get_probe(texCoord.xy, _cascadeIndex + 1);

	vec2 texelIndexN1 = floor((vec2(probeInfo.probe.xy) - 1.0) / 2.0);
	vec2 texelIndexN1_N = floor((texelIndexN1 * 2.0) + 1.0);

    //
	vec4 radiance = imageLoad(_cascadeTex, texCoord);
	radiance.a = 1.0 - radiance.a;

	// Check ray visibility term from raymarching, on hit merge, otherwise no merge:
	if (radiance.a != 0.0 && _cascadeIndex < _cascadeCount - 1.0) {
		vec4 TL = vec4(0.0), TR = vec4(0.0), BL = vec4(0.0), BR = vec4(0.0);
		
		// We always default to a 4x ray branch scaling between cascades.
		const float branch4 = 4.0;
		for(float i = 0.0; i < branch4; i++) {
			float thetaIndexN1 = (probeInfo.index * branch4) + i;
			TL += cascadeFetch(probeInfoN1, _cascadeIndex + 1, texelIndexN1 + vec2(0.0,0.0), thetaIndexN1);
			TR += cascadeFetch(probeInfoN1, _cascadeIndex + 1, texelIndexN1 + vec2(1.0,0.0), thetaIndexN1);
			BL += cascadeFetch(probeInfoN1, _cascadeIndex + 1, texelIndexN1 + vec2(0.0,1.0), thetaIndexN1);
			BR += cascadeFetch(probeInfoN1, _cascadeIndex + 1, texelIndexN1 + vec2(1.0,1.0), thetaIndexN1);
		}
		
		// Per Specification:
		//vec2 weight = vec2(0.25) + (vec2(probeInfo.probe) - texelIndexN1_N) * vec2(0.5);
		
		// Smoother Weights:
		vec2 weight = vec2(0.33) + (vec2(probeInfo.probe.xy) - texelIndexN1_N) * vec2(0.33);
		
		vec4 interpolated = mix(mix(TL, TR, weight.x), mix(BL, BR, weight.x), weight.y) / branch4;
		interpolated.a = 1.0 - interpolated.a;
		radiance += radiance.a * interpolated;
	}
	
    if (_cascadeIndex == 0) radiance.rgb = SRGB(radiance.rgb);
    imageStore(_cascadeTex, texCoord, vec4(radiance.rgb, 1.0));
}