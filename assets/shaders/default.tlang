[program('default', vert='default_vert', frag='default_frag')]

[shader('vert')]
[resourceblock(
    in vec2 vert;
    in vec2 texCoord;
    out vec2 v_uv;
)]
void default_vert() {
    v_uv = texCoord;
    gl_Position = vec4(vert, 0.0, 1.0);
}

[shader('frag')]
[resourceblock(
    uniform sampler2D _mainTex;
    uniform bool _flip;

    in vec2 v_uv;
    out vec4 fragColour;
)]
void default_frag() {
    vec2 uv = vec2(v_uv.x, (_flip) ? 1 - v_uv.y : v_uv.y);
    fragColour = vec4(texture(_mainTex, uv).rgba);
}
