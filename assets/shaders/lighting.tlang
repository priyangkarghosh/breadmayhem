[program('screen_uv', vert='default_vert', frag='screen_uv')]
[program('jump_flood', vert='default_vert', frag='jump_flood')]
[program('distance_field', vert='default_vert', frag='distance_field')]
[program('cascades', vert='default_vert', frag='cascades')]
[program('debug', vert='default_vert', frag='debug')]

[shader('vert')]
[resourceblock(
    in vec2 vert;
    in vec2 texCoord;
    out vec2 v_uv;
)]
void default_vert() {
    v_uv = texCoord;
    gl_Position = vec4(vert, 0.0, 1.0);
}

[shader('frag')]
[resourceblock(
    uniform sampler2D _tex;

    in vec2 v_uv;
    out vec4 fragColour;
)]
void screen_uv() {
    vec4 texColour = texture(_tex, v_uv);
    if (any(greaterThan(texColour.rgb, vec3(0.0)))) 
        fragColour = vec4(v_uv.x * texColour.a, v_uv.y * texColour.a, 0.0, 1.0);
    else fragColour = vec4(0.0, 0.0, 0.0, 1.0);
}

[shader('frag')]
[resourceblock(
    uniform sampler2D _tex;
    uniform ivec2 _stepSize;

    in vec2 v_uv;
    out vec4 fragColour;
)]
void jump_flood() {
    float closestDist = 1.0;
    vec2 closestSeed = vec2(0.0);
    
    ivec2 centerPx = ivec2(gl_FragCoord.xy);
    for (int dy = -1; dy <= 1; ++dy) {
        for (int dx = -1; dx <= 1; ++dx) {
            ivec2 samplePx = centerPx + ivec2(dx, dy) * _stepSize;
            vec2 seedUV = texelFetch(_tex, samplePx, 0).xy;            
            if (seedUV == vec2(0.0)) continue;
            
            vec2 offset = seedUV - v_uv;
            float dist = dot(offset, offset);
            if (dist > closestDist) continue;
            
            // update
            closestDist = dist;
            closestSeed = seedUV;
        }
    }
    
    fragColour = vec4(closestSeed, 0.0, 1.0);
}

[shader('frag')]
[resourceblock(
    uniform sampler2D _tex;

    in vec2 v_uv;
    out vec4 fragColour;
)]
void distance_field() {
    vec2 uv = texelFetch(_tex, ivec2(gl_FragCoord.xy), 0).xy;
    fragColour = vec4(distance(v_uv, uv), 0.0, 0.0, 1.0);
}

const float TAU = 6.28318530718;
const float EPSILON = 1e-3;

struct probe_info { float angular; vec2 linear, size, probe; float index, offset, range, scale; };

[link('cascades')]
probe_info generate_probe() {
    // probe properties
    float angular = pow(2.0, _cascadeIndex);
    vec2 linear = vec2(_cascadeLinear * angular);
    vec2 size = _cascadeResolution / angular;

    // probe index
    vec2 probe = mod(floor(v_uv * _cascadeResolution), size);
    vec2 rayCoord = floor(v_uv * angular);
    float ray = rayCoord.x + (angular * rayCoord.y);

    // ray ranges
    float offset = (_cascadeInterval * (1.0 - pow(4.0, _cascadeIndex))) / (1.0 - 4.0);
    float range = _cascadeInterval * pow(4.0, _cascadeIndex);
    range += length(vec2(_cascadeLinear * pow(2.0, _cascadeIndex + 1.0)));

    // scaling factor
    float scale = length(_renderResolution);
    return probe_info(
        angular * angular, linear, size, probe, ray, offset, range, scale
    );
}

[link('cascades')]
vec4 raymarch(vec2 origin, float theta, probe_info probe) {
    vec2 texel = 1.0 / _renderResolution;
    vec2 delta = vec2(cos(theta), -sin(theta));

    vec2 ray = (origin + (delta * probe.offset)) * texel;
	for(float i = 0.0, df = 0.0, rd = 0.0; i < probe.range; i++) {
		df = texture(_distanceTex, ray).r;
        rd += df * probe.scale;
        ray += (delta * df * probe.scale * texel);

		if (rd >= probe.range || floor(ray) != vec2(0.0)) break;
        if (df <= EPSILON && rd <= EPSILON && _cascadeIndex != 0.0) return vec4(0.0);
        if (df < EPSILON) {
            vec3 emission = texture(_emissiveTex, ray).rgb;
            if (length(emission) > 0.0) 
                return vec4(emission, 0.0);
            else {
                vec3 baseColor = texture(_albedoTex, ray).rgb;
                return vec4(baseColor, 0.0);
            }
        }
	}
	return vec4(0.0, 0.0, 0.0, 1.0);
}

[link('cascades')]
vec4 merge(vec4 rinfo, float index, probe_info pinfo) {
	if (rinfo.a == 0.0 || _cascadeIndex >= _cascadeCount - 1.0)
		return vec4(rinfo.rgb, 1 - rinfo.a);
	
	float angularN1 = pow(2.0, _cascadeIndex + 1.0);
	vec2 sizeN1 = pinfo.size * 0.5;
	vec2 probeN1 = vec2(mod(index, angularN1), floor(index / angularN1)) * sizeN1;
	vec2 interpUVN1 = (pinfo.probe * 0.5) + 0.25;
	vec2 clampedUVN1 = max(vec2(1.0), min(interpUVN1, sizeN1 - 1.0));
	vec2 probeUVN1 = (probeN1 + clampedUVN1) * (1.0 / _cascadeResolution);
	vec4 interpolated = texture(_tex, probeUVN1);
    //return rinfo + interpolated;
	return vec4(rinfo.rgb + interpolated.rgb * rinfo.a, rinfo.a * interpolated.a);
}

[shader('frag')]
[resourceblock(
    uniform sampler2D _tex;
    uniform sampler2D _albedoTex;
    uniform sampler2D _emissiveTex;
    uniform sampler2D _distanceTex;

    uniform vec2 _renderResolution;
    uniform vec2 _cascadeResolution;
    
    uniform int _cascadeIndex;
    uniform int _cascadeCount;
    uniform float _cascadeLinear; // probe density of cascade0 
    uniform float _cascadeInterval; // ray interval length of cascade0

    in vec2 v_uv;
    out vec4 fragColour;
)]
void cascades() {
    probe_info pinfo = generate_probe();

    // screen space ray origin
    vec2 origin = (pinfo.probe + 0.5) * pinfo.linear;
    float angleStep = TAU / (pinfo.angular * 4.0);
    //fragColour = vec4(origin / _renderResolution, 0.0, 1.0);
    float base = pinfo.index * 4;
	for (float i = 0.0; i < 4.0; i++) {
        float index = base + i;
		float theta = (index + 0.5) * angleStep;	
		vec4 radiance = raymarch(origin, theta, pinfo);
		fragColour += merge(radiance, index, pinfo) * 0.25;
	}
    fragColour += vec4(v_uv * EPSILON, 0.0, 0.0);
}
