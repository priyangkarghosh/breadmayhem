[program('cascades', vert='default_vert', frag='cascades')]
[program('diffuse', vert='default_vert', frag='diffuse')]

const float TAU = 6.28318530718;
const float EPSILON = 1e-3;

#define SRGB(c) pow(c.rgb, vec3(1.0 / 2.2))
#define LINEAR(c) pow(c.rgb, vec3(2.2))

[shader('vert')]
[resourceblock(
    in vec2 vert;
    in vec2 texCoord;
    out vec2 v_uv;
)]
void default_vert() {
    v_uv = vec2(texCoord.x, 1 - texCoord.y);
    gl_Position = vec4(vert, 0.0, 1.0);
}

[link('cascades')]
void raymarch(vec2 origin, vec2 delta, float range, out vec4 radiance, out vec4 transmittance) {
    vec2 texel = 1.0 / _renderResolution;

    vec2 ray = origin * texel;
    vec2 step = delta * texel;

    radiance = vec4(0.0);
    transmittance = vec4(1.0);
    for(float i = 0.0; i < range; i++) {
        ray += step;
        if (floor(ray) != vec2(0.0)) break;
        
        vec3 emiss = LINEAR(texture(_emissiveTex, ray).rgb);
		vec3 absrp = LINEAR(texture(_albedoTex, ray).rgb);

		vec3 trans = exp(-absrp);
        radiance.rgb += (emiss - emiss * trans) * transmittance.rgb;
        transmittance.rgb *= trans;
    }

    radiance = vec4(radiance.rgb, 1.0);
}

[link('cascades')]
vec4 merge(vec4 radiance, vec4 transmittance, float index, vec2 probe) {
	if (_cascadeIndex >= _cascadeCount - 1.0) return radiance;
    
	float angularN1 = pow(2.0, floor(_cascadeIndex + 1.0));
	vec2 extentN1 = floor(_cascadeResolution / angularN1);

	vec2 interpN1 = vec2(mod(index, angularN1), floor(index / angularN1)) * extentN1;
    interpN1 += clamp((probe * 0.5) + 0.25, vec2(0.5), extentN1 - 0.5);

	vec4 mergeRadiance = texture(_tex, interpN1 / _cascadeResolution);
	return radiance + mergeRadiance * transmittance;
}

[shader('frag')]
[resourceblock(
    uniform sampler2D _tex;
    uniform sampler2D _albedoTex;
    uniform sampler2D _emissiveTex;

    uniform vec2 _renderResolution;
    uniform vec2 _cascadeResolution;
    
    uniform int _cascadeIndex;
    uniform int _cascadeCount;
    uniform float _cascadeScale; // probe density of cascade0 
    uniform float _cascadeInterval; // ray interval length of cascade0

    in vec2 v_uv;
    out vec4 fragColour;
)]
void cascades() {
    float sqrtAngular = floor(pow(2, _cascadeIndex));
    float angular = floor(sqrtAngular * sqrtAngular * 4.0);

    vec2 coord = floor(v_uv * _cascadeResolution);
    vec2 extent = floor(_cascadeResolution / sqrtAngular);
    vec4 probe = vec4(mod(coord, extent), floor(coord / extent));
    vec2 linear = vec2(_cascadeScale * sqrtAngular);
    
    float offset = _cascadeInterval * ((1.0 - pow(4.0, _cascadeIndex)) / (1.0 - 4.0));
    float range = _cascadeInterval * pow(4.0, _cascadeIndex);
    range += length(linear * 2.0);

    // screen space ray origin
    vec2 origin = (probe.xy + 0.5) * linear;
    float base = (probe.z + (probe.w * sqrtAngular)) * 4.0;

    [unroll]
    vec4 acc = vec4(0);
	for (float i = 0; i < 4; i++) {
        float index = base + i;
		float theta = (index + 0.5) * (TAU / angular);	
        vec2 delta = vec2(cos(theta), -sin(theta));
        vec2 ray = origin + (delta * offset);

        vec4 radiance, transmittance;
		raymarch(ray, delta, range, radiance, transmittance);
		acc += merge(radiance, transmittance, index, probe.xy) * 0.25;
	}
	
    if (_cascadeIndex == 0.0) acc = vec4(SRGB(acc.rgb), 1.0);
    fragColour = acc;
}

[shader('frag')]
[resourceblock(
    uniform sampler2D _tex;
    uniform sampler2D _occlusionTex;
    uniform sampler2D _radianceTex;
    uniform vec2 _renderResolution;

    in vec2 v_uv;
    out vec4 fragColour;
)]
void diffuse() {
    const float SCATTER_COEFF = 1.5;
    vec3 fin = texture(_tex, v_uv).rgb * 0.3;
    float t = texture(_occlusionTex, v_uv).r;
    if (t >= EPSILON) fin += texture(_radianceTex, v_uv).rgb * SCATTER_COEFF * 0.7;
    fragColour.rgb = fin;
}