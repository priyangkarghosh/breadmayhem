[include(dda)]
[program('cascades', vert='default_vert', frag='cascades')]
[program('diffuse', vert='default_vert', frag='diffuse')]

const float TAU = 6.28318530718;
const float EPSILON = 1e-3;

#define SRGB(c) pow(c.rgb, vec3(1.0 / 2.2))
#define LINEAR(c) pow(c.rgb, vec3(2.2))

[shader('vert')]
[resourceblock(
    in vec2 vert;
    in vec2 texCoord;
    out vec2 v_uv;
)]
void default_vert() {
    v_uv = vec2(texCoord.x, 1 - texCoord.y);
    gl_Position = vec4(vert, 0.0, 1.0);
}

[link("cascades")]
void raymarch(vec2 origin, vec2 delta, float range, out vec4 radiance, out vec4 transmittance) {
    // init default values
    radiance = vec4(0.0, 0.0, 0.0, 1.0);
    transmittance = vec4(1.0);

    // 
    const vec2 texel = 1.0 / _renderResolution;
    const float rmStepSize = pow(2.0, _cascadeIndex) * 0.5;
    const vec2 rmStepDelta = delta * rmStepSize * texel;
    const vec2 invDelta = sign(delta) / max(abs(delta), vec2(EPSILON));
    const float invRange = 1.0 / range;

    // set up dda
    const vec2 cellSize = vec2(SUBGROUP_SIZE);
    const ivec2 cellStep = ivec2(sign(delta));
    const ivec2 gridSize = ivec2(ceil(_renderResolution / cellSize));
    ivec2 cell = ivec2(floor(origin / cellSize));

    // calculate next boundary for dda
    vec2 nextBoundary;
    nextBoundary.x = (float(cell.x) + float(max(0, cellStep.x))) * cellSize.x;
    nextBoundary.y = (float(cell.y) + float(max(0, cellStep.y))) * cellSize.y;

    // calculate distance along ray
    vec2 tMax = abs((nextBoundary - origin) * invDelta);
    vec2 tDelta = abs(cellSize * invDelta);

    // dda loop
    float t = 0.0;
    while (t < range) {
        // bounds check
        if (cell.x < 0 || cell.y < 0 || cell.x >= gridSize.x || cell.y >= gridSize.y) return;
        int idx = cell.x + cell.y * gridSize.x;

        // check axis
        float tNext;
        if (tMax.x <= tMax.y) {
            tNext = tMax.x;
            tMax.x += tDelta.x;
            cell.x += cellStep.x;
        } else {
            tNext = tMax.y;
            tMax.y += tDelta.y;
            cell.y += cellStep.y;
        }

        // if cell is occupied, then raymarch
        // -> skip otherwise
        if (grid[idx] != 0) {
            float tEnter = max(t, 0.0);
            float tExit = min(tNext, range);

            // start march for this cell
            float marchLen = tExit - tEnter;
            int marchSteps = int(ceil(marchLen / rmStepSize)) + 1;
            vec2 ray = (origin + delta * tEnter) * texel;
            for (int s = 0; s < marchSteps; s++) {
                // bounds check
                float p = tEnter + float(s) * rmStepSize;
                if (ray.x < 0 || ray.y < 0 || ray.x > 1 || ray.y > 1 || p >= range) 
                    return;

                // sample emission and absorption textures
                float mip = _cascadeIndex + min(1.0 - EPSILON, p * invRange);
                vec3 emiss = LINEAR(textureLod(_emissiveTex, ray, mip).rgb);
                vec3 absrp = LINEAR(textureLod(_albedoTex, ray, mip).rgb);

                // update radiance/transmittance at this point
                vec3 trans = exp(-absrp * rmStepSize);
                vec3 coeff = (1.0 - trans) / max(absrp, vec3(EPSILON));
                radiance.rgb += emiss * coeff * transmittance.rgb;
                transmittance.rgb *= trans;
                ray += rmStepDelta;

                // early exit if transmittance is too low
                if (all(lessThan(transmittance.rgb, vec3(EPSILON))))
                    return;
            }
        }

        t = tNext;
    }
}

[link('cascades')]
vec4 merge(vec4 radiance, vec4 transmittance, int index, vec2 probe) {
	if (_cascadeIndex >= _cascadeCount - 1) return radiance;
    
	float angularN1 = 1 << (_cascadeIndex + 1);
	vec2 extentN1 = floor(_cascadeResolution / angularN1);
	vec2 interpN1 = vec2(floor(mod(index, angularN1)), floor(index / angularN1)) * extentN1;
    interpN1 += clamp((probe * 0.5) + 0.25, vec2(0.5), extentN1 - 0.5);

	vec4 mergeRadiance = texture(_tex, interpN1 / _cascadeResolution);
	return radiance + mergeRadiance * transmittance;
}

[shader('frag')]
[resourceblock(
    uniform sampler2D _tex;
    uniform sampler2D _albedoTex;
    uniform sampler2D _emissiveTex;

    uniform vec2 _renderResolution;
    uniform vec2 _cascadeResolution;
    
    uniform int _cascadeIndex;
    uniform int _cascadeCount;
    uniform float _cascadeScale; // probe density of cascade0 
    uniform float _cascadeInterval; // ray interval length of cascade0

    in vec2 v_uv;
    out vec4 fragColour;
)]
void cascades() {
    float sqrtAngular = floor(1 << _cascadeIndex);
    float angular = floor(sqrtAngular * sqrtAngular * 4);

    ivec2 coord = ivec2(floor(v_uv * _cascadeResolution));
    ivec2 extent = ivec2(floor(_cascadeResolution / sqrtAngular));
    ivec4 probe = ivec4(mod(coord, extent), floor(coord / extent));
    vec2 linear = vec2(_cascadeScale * sqrtAngular);
    
    float pow4 = floor(1 << (2 * _cascadeIndex));
    float offset = _cascadeInterval * ((1.0 - pow4) / -3);
    float range = _cascadeInterval * pow4;
    range += length(linear * 2.0);

    // screen space ray origin
    vec2 origin = (probe.xy + 0.5) * linear;
    int base = int(probe.z + (probe.w * sqrtAngular)) * 4;
    float angleStep = TAU / angular;

    [unroll]
	for (int i = 0; i < 4; i++) {
        int index = base + i;
		float theta = (index + 0.5) * angleStep;	
        vec2 delta = vec2(cos(theta), -sin(theta));
        vec2 rayStart = origin + (delta * offset);

        vec4 radiance, transmittance;
		raymarch(rayStart, delta, range, radiance, transmittance);
		fragColour += merge(radiance, transmittance, index, probe.xy) * 0.25;
	}
	
    if (_cascadeIndex == 0) fragColour = vec4(SRGB(fragColour.rgb), 1.0);
}

[shader('frag')]
[resourceblock(
    uniform sampler2D _tex;
    uniform sampler2D _occlusionTex;
    uniform sampler2D _radianceTex;
    uniform vec2 _renderResolution;

    in vec2 v_uv;
    out vec4 fragColour;
)]
void diffuse() {
    const float SCATTER_COEFF = 1.5;
    vec3 fin = texture(_tex, v_uv).rgb * 0.3;
    float t = texture(_occlusionTex, v_uv).r;
    if (t >= EPSILON) fin += texture(_radianceTex, v_uv).rgb * SCATTER_COEFF * 0.7;
    fragColour.rgb = fin;
}