[include(dda)]
[program('cascades', vert='default_vert', frag='cascades')]
[program('blit', vert='default_vert', frag='blit')]
[program('diffuse', vert='default_vert', frag='diffuse')]

const float TAU = 6.28318530718;
const float EPSILON = 1e-3;

#define SRGB(c) pow(c.rgb, vec3(1.0 / 2.2))
#define LINEAR(c) pow(c.rgb, vec3(2.2))

[shader('vert')]
[resourceblock(
    in vec2 vert;
    in vec2 texCoord;
    out vec2 v_uv;
)]
void default_vert() {
    v_uv = vec2(texCoord.x, clamp(1.0 - texCoord.y, 0.0, 1.0));
    gl_Position = vec4(vert, 0.0, 1.0);
}

[link('cascades')]
void raymarch(vec2 origin, vec2 delta, float range, out vec4 radiance, out vec4 transmittance) {
    radiance = vec4(0.0, 0.0, 0.0, 1.0);
    transmittance = vec4(1.0);
    
    const vec2 texel = 1.0 / _renderResolution;
    const vec2 cellSize = vec2(SUBGROUP_SIZE);
    const ivec2 gridSize = ivec2(ceil(_renderResolution / cellSize));
    const float rmStepSize = exp2(_cascadeIndex - 2);
    
    int numSteps = int(ceil(range / rmStepSize));
    for (int i = 0; i < numSteps; i++) {
        float t = i * rmStepSize;
        vec2 ray = origin + delta * t;
        
        // bounds checking
        vec2 uv = ray * texel;
        if (floor(uv) != vec2(0.0)) return;
        
        ivec2 cell = ivec2(floor(ray / cellSize));
        if (any(lessThan(cell, ivec2(0))) || any(greaterThanEqual(cell, gridSize))) 
            return;
        
        int idx = cell.x + cell.y * gridSize.x;
        if (grid[idx] != 0) {
            float mip = float(_cascadeIndex) * 0.5 + (t / range);    
            vec3 emiss = LINEAR(textureLod(_emissiveTex, uv, mip).rgb + texture(_diffuseTex, uv).rgb);
            vec3 absrp = LINEAR(textureLod(_absorptionTex, uv, mip).rgb);
            
            // beer-lambert law integration
            vec3 trans = exp(-absrp * rmStepSize);
            vec3 coeff = (1.0 - trans) / max(absrp, vec3(EPSILON));
            radiance.rgb += emiss * coeff * transmittance.rgb;
            transmittance.rgb *= trans;
            
            // early termination if transmittance is negligible
            if (all(lessThan(transmittance.rgb, vec3(EPSILON)))) {
                transmittance.rgb = vec3(0.0);
                return;
            }
        }
    }
}

[link('cascades')]
void getBilinearProbes(vec2 probe, out vec2 probes[4]) {
	vec2 probeN1 = floor((probe - 1.0) / 2.0);
	probes[0] = probeN1 + vec2(0.0, 0.0);
	probes[1] = probeN1 + vec2(1.0, 0.0);
	probes[2] = probeN1 + vec2(0.0, 1.0);
	probes[3] = probeN1 + vec2(1.0, 1.0);
}

[link('cascades')]
vec4 merge(vec4 radiance, vec4 transmittance, float index, vec2 probe) {
	if (_cascadeIndex >= _cascadeCount - 1) return radiance;
    
	float angularN1 = 1 << (_cascadeIndex + 1);
	vec2 extentN1 = floor(_cascadeResolution / angularN1);

	vec2 interpN1 = vec2(mod(index, angularN1), floor(index / angularN1)) * extentN1;
    interpN1 += clamp(probe + 0.5, vec2(0.5), extentN1 - vec2(0.5));
	vec4 mergeRadiance = texture(_mainTex, interpN1 / _cascadeResolution);
	return radiance + mergeRadiance * transmittance;
}

[shader('frag')]
[resourceblock(
    uniform sampler2D _mainTex;
    uniform sampler2D _emissiveTex;
    uniform sampler2D _absorptionTex;
    uniform sampler2D _diffuseTex;

    uniform vec2 _renderResolution;
    uniform vec2 _cascadeResolution;
    
    uniform int _cascadeIndex;
    uniform int _cascadeCount;
    uniform float _cascadeScale; // probe density of cascade0 
    uniform float _cascadeInterval; // ray interval length of cascade0

    in vec2 v_uv;
    out vec4 fragColour;
)]
void cascades() {
    float sqrtAngular = floor(1 << _cascadeIndex);
    float angular = floor(sqrtAngular * sqrtAngular * 4);

    ivec2 coord = ivec2(floor(v_uv * _cascadeResolution));
    ivec2 extent = ivec2(floor(_cascadeResolution / sqrtAngular));
    ivec4 probe = ivec4(mod(coord, extent), floor(coord / extent));
    vec2 linear = vec2(_cascadeScale * sqrtAngular);
    vec2 linearN1 = vec2(_cascadeScale * pow(2.0, _cascadeIndex + 1.0));
    
    float pow4 = floor(1 << (2 * _cascadeIndex));
    float offset = _cascadeInterval * ((1.0 - pow4) / -3.0);
    float range = _cascadeInterval * pow4;

    // screen space ray origin
    vec2 origin = (probe.xy + 0.5) * linear;
    int base = int(probe.z + (probe.w * sqrtAngular)) * 4;
    float angleStep = TAU / angular;

    // === bilinear fix === 
	vec2 bilinearN1[4];
	getBilinearProbes(probe.xy, bilinearN1);
	vec2 texelIndexN1 = floor((vec2(probe.xy) - 1.0) / 2.0);
	vec2 texelIndexN1_N = floor((texelIndexN1 * 2.0) + 1.0);
	vec2 weight = vec2(0.25) + (vec2(probe.xy) - texelIndexN1_N) * vec2(0.5);
    fragColour = vec4(0.0);
    // =================== 

    [unroll]
	for (float i = 0; i < 4; i++) {
        float index = base + i;

		float theta = (index + 0.5) * (TAU / angular);	
        float thetaNm1 = (floor(index / 4.0) + 0.5) * (TAU / (angular / 4.0));

        vec2 delta = vec2(cos(theta), -sin(theta));
        vec2 deltaNm1 = vec2(cos(thetaNm1), -sin(thetaNm1));

		vec4 samples[4];
        vec2 ray_start = origin + (deltaNm1 * offset);

        [unroll]
		for(int j = 0; j < 4; j++) {
            vec2 originN1 = (bilinearN1[j] + 0.5) * linearN1;
			vec2 ray_end = originN1 + (delta * (offset + range));

            vec4 radiance, transmittance;
			raymarch(ray_start, normalize(ray_end - ray_start), length(ray_end - ray_start), radiance, transmittance);
            samples[j] = merge(radiance, transmittance, index, bilinearN1[j]);
		}

        vec4 top = mix(samples[0], samples[1], weight.x);
		vec4 bot = mix(samples[2], samples[3], weight.x);
		fragColour += mix(top, bot, weight.y) * 0.25;
	}
	
    if (_cascadeIndex == 0) fragColour = vec4(SRGB(fragColour.rgb), 1.0);
}

[shader('frag')]
[resourceblock(
    uniform sampler2D _mainTex; // albedo
    uniform sampler2D _radianceTex;
    uniform sampler2D _radianceTex2;
    uniform vec2 _renderResolution;

    in vec2 v_uv;
    out vec4 fragColour;
)]
void blit() {
    vec2 uv = vec2(v_uv.x, 1.0 - v_uv.y);
    vec4 albedo = texture(_mainTex, uv);
    ivec2 radCoord = ivec2(uv * _renderResolution);
    vec4 radiance1 = texelFetch(_radianceTex, radCoord, 0);
    vec4 radiance2 = texelFetch(_radianceTex2, radCoord, 0);
    fragColour = radiance1 + radiance2;
}

[shader('frag')]
[resourceblock(
    uniform sampler2D _mainTex; // prev diffuse
    uniform sampler2D _albedoTex;
    uniform sampler2D _radianceTex;
    uniform vec2 _renderResolution;

    in vec2 v_uv;
    out vec4 fragColour;
)]
void diffuse() {
    vec3 albedo = texture(_albedoTex, v_uv).rgb;
    ivec2 radCoord = ivec2(v_uv * _renderResolution);
    vec3 diffuse = albedo * texelFetch(_radianceTex, radCoord, 0).rgb;
    fragColour = mix(texture(_mainTex, v_uv), vec4(diffuse, 1.0), 0.5);
}