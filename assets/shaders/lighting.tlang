[program('screen_uv', vert='default_vert', frag='screen_uv')]
[program('jump_flood', vert='default_vert', frag='jump_flood')]
[program('distance_field', vert='default_vert', frag='distance_field')]

[shader('vert')]
[resourceblock(
    in vec2 vert;
    in vec2 texCoord;
    out vec2 v_uv;
)]
void default_vert() {
    v_uv = texCoord;
    gl_Position = vec4(vert, 0.0, 1.0);
}

[shader('frag')]
[resourceblock(
    uniform sampler2D tex;

    in vec2 v_uv;
    out vec4 fragColour;
)]
void screen_uv() {
    vec4 col = texture(tex, v_uv);
    if (any(greaterThan(col.rgb, vec3(0.0)))) fragColour = vec4(v_uv, 0.0, 1.0);
    else fragColour = vec4(0.0, 0.0, 0.0, 1.0);
}

[shader('frag')]
[resourceblock(
    uniform sampler2D tex;
    uniform float stepSize;
    uniform vec2 aspect;

    in vec2 v_uv;
    out vec4 fragColour;
)]
void jump_flood() {
    float minDist = 1;
    vec2 bestUV = vec2(0.0);
    for (int y = -1; y <= 1; ++y) {
        for (int x = -1; x <= 1; ++x) {
            vec2 peekUV = v_uv + vec2(x, y) * aspect * stepSize;
            vec2 peek = texture(tex, peekUV).xy;
            if (peek == vec2(0.0)) continue;

            vec2 dir = peek - v_uv;
            float d = dot(dir, dir);

            if (d < minDist) {
                minDist = d;
                bestUV = peek;
            }
        }
    }

    fragColour = vec4(bestUV, 0.0, 1.0);
}

[shader('frag')]
[resourceblock(
    uniform sampler2D tex;

    in vec2 v_uv;
    out vec4 fragColour;
)]
void distance_field() {
    vec2 uv = texture(tex, v_uv).rg;
    fragColour = vec4(distance(v_uv, uv), 0.0, 0.0, 1.0);
}
