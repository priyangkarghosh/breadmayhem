[program('screen_uv', vert='default_vert', frag='screen_uv')]
[program('jump_flood', vert='default_vert', frag='jump_flood')]
[program('distance_field', vert='default_vert', frag='distance_field')]
[program('cascades', vert='default_vert', frag='cascades')]

const float TAU = 6.28318530718;
const float EPSILON = 1e-3;

#define SRGB(c) pow(c.rgb, vec3(2.2))
#define LINEAR(c) pow(c.rgb, vec3(1.0 / 2.2))

[shader('vert')]
[resourceblock(
    in vec2 vert;
    in vec2 texCoord;
    out vec2 v_uv;
)]
void default_vert() {
    v_uv = vec2(texCoord.x, 1 - texCoord.y);
    gl_Position = vec4(vert, 0.0, 1.0);
}

[shader('frag')]
[resourceblock(
    uniform sampler2D _tex;

    in vec2 v_uv;
    out vec4 fragColour;
)]
void screen_uv() {
    vec4 texColour = texture(_tex, v_uv);
    if (any(greaterThan(texColour.rgb, vec3(0.0)))) 
        fragColour = vec4(v_uv.x * texColour.a, v_uv.y * texColour.a, 0.0, 1.0);
    else fragColour = vec4(0.0, 0.0, 0.0, 1.0);
}

[shader('frag')]
[resourceblock(
    uniform sampler2D _tex;
    uniform ivec2 _stepSize;

    in vec2 v_uv;
    out vec4 fragColour;
)]
void jump_flood() {
    float closestDist = 1.0;
    vec2 closestSeed = vec2(0.0);
    
    ivec2 centerPx = ivec2(gl_FragCoord.xy);
    for (int dy = -1; dy <= 1; ++dy) {
        for (int dx = -1; dx <= 1; ++dx) {
            ivec2 samplePx = centerPx + ivec2(dx, dy) * _stepSize;
            vec2 seedUV = texelFetch(_tex, samplePx, 0).xy;            
            if (seedUV == vec2(0.0)) continue;
            
            vec2 offset = seedUV - v_uv;
            float dist = dot(offset, offset);
            if (dist > closestDist) continue;
            
            // update
            closestDist = dist;
            closestSeed = seedUV;
        }
    }
    
    fragColour = vec4(closestSeed, 0.0, 1.0);
}

[shader('frag')]
[resourceblock(
    uniform sampler2D _tex;

    in vec2 v_uv;
    out vec4 fragColour;
)]
void distance_field() {
    vec2 uv = texelFetch(_tex, ivec2(gl_FragCoord.xy), 0).xy;
    fragColour = vec4(distance(v_uv, uv), 0.0, 0.0, 1.0);
}

