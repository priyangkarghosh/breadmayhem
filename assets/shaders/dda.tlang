[extend!('subgroup')]

#define SUBGROUP_SIZE {{ SUBGROUP_SIZE }}
layout(std430) buffer Grid { uint grid[]; };

[shader('compute'), numthreads(SUBGROUP_SIZE, SUBGROUP_SIZE, 1)]
[resourceblock(
    uniform sampler2D _mainTex;
    uniform vec2 _renderResolution;
    shared uint cluster;
)]
void dda() {
    // grid index
    uint index = gl_WorkGroupID.x + (gl_WorkGroupID.y * gl_NumWorkGroups.x);
    const uint tid = gl_LocalInvocationIndex;
    if (tid == 0) cluster = 0;
    
    vec3 s = texelFetch(_mainTex, ivec2(gl_GlobalInvocationID.xy), 0).rgb;
    if (subgroupAny(any(greaterThan(s, vec3(0)))) && subgroupElect()) atomicOr(cluster, 1);
    barrier();

    if (tid == 0) grid[index] = cluster;
}